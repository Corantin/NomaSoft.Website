# Public URL of the deployed site
NEXT_PUBLIC_SITE_URL=https://nomasoft.example

# Default locale for localized routing (en or fr)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Optional domain name for Plausible analytics tracking
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Contact form email recipients (falls back to content/site.json contact email)
CONTACT_TO_EMAIL=team@nomasoft.dev
# Optional default "from" address if different from the recipient
CONTACT_FROM_EMAIL=donotreply@nomasoft.dev

# Resend configuration (leave blank if using SMTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@nomasoft.dev

# SMTP configuration (leave blank if using Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Bot protection (set both secret and site key; first successful form skips challenge, then cache verification for 24 hours)
# hCaptcha challenge difficulty is configured for the site key in the hCaptcha dashboard, not with HCAPTCHA_SECRET.
HCAPTCHA_SECRET=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
# Set to true to use the production keys while running locally (defaults to hCaptcha's test keys)
HCAPTCHA_USE_PROD_KEYS_IN_DEV=false
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Apple Wallet (base64-encoded PEM files; set all values to enable the button)
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_SIGNER_CERT_B64=
APPLE_WALLET_SIGNER_KEY_B64=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_CERT_B64=

# Google Wallet (run scripts/setup-google-wallet.mjs before enabling)
GOOGLE_WALLET_ISSUER_ID=3388000000023238394
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_WALLET_READY=false

# CRM sign-in uses the existing Resend sender and email API key.
# Generate NEXTAUTH_SECRET with openssl rand -base64 32.
NEXTAUTH_SECRET=
NEXTAUTH_URL=
CRM_SHEETS_WEB_APP_URL=
CRM_SHEETS_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
